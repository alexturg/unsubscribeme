[Unit]
Description=UnsubscribeMe Telegram RSS Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=unsubscribeme
Group=unsubscribeme
WorkingDirectory=/var/lib/unsubscribeme
EnvironmentFile=/etc/unsubscribeme/environment
EnvironmentFile=/etc/unsubscribeme/paths
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/unsubscribeme/current/.venv/bin/unsubscribeme
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/unsubscribeme
RestrictSUIDSGID=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
